<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The tests run on the installed .NET 8 runtime. The plugin itself targets net7.0 for Rhino 8. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Import_DEM.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Only the layers that do not use RhinoCommon. The surface build needs Rhino, so
       tools/rhino_import_test.py checks it inside Rhino. -->
  <ItemGroup>
    <Compile Include="../../src/Import_DEM/Formats/**/*.cs" LinkBase="Formats" />
    <Compile Include="../../src/Import_DEM/Grid/**/*.cs" LinkBase="Grid" />
    <Compile Include="../../src/Import_DEM/Gdal/**/*.cs" LinkBase="Gdal" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures" />
  </ItemGroup>

</Project>
